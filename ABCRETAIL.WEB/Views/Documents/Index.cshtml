@model IEnumerable<StoredFileInfo>
@using ABCRETAIL.WEB.Services
@{
    ViewData["Title"] = "Documents";
}

<div class="page-header">
    <h1>Documents (Azure Files)</h1>
</div>

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="form upload-form">
    <div class="form-group">
        <label for="file">Upload a document</label>
        <input type="file" id="file" name="file" required />
    </div>
    <button type="submit" class="btn">Upload to Azure Files</button>
</form>

<table class="data-table">
    <thead>
        <tr>
            <th>File Name</th>
            <th>Size</th>
            <th>Last Modified</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td>@f.FileName</td>
                <td>@((f.SizeBytes / 1024.0).ToString("N1")) KB</td>
                <td>@f.LastModified?.ToString("dd MMM yyyy HH:mm")</td>
                <td class="actions">
                    <a asp-action="Download" asp-route-fileName="@f.FileName">Download</a>
                    <form asp-action="Delete" method="post" style="display:inline">
                        <input type="hidden" name="fileName" value="@f.FileName" />
                        <button type="submit" class="link-btn danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="empty">No documents uploaded yet.</td></tr>
        }
    </tbody>
</table>
