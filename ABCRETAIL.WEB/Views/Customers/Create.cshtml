@model CustomerProfile
@{
    ViewData["Title"] = "New Customer";
}

<h1>New Customer Profile</h1>

<form asp-action="Create" method="post" class="form">
    <div class="form-group">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" required />
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" required />
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" />
    </div>
    <div class="form-group">
        <label asp-for="ShippingAddress"></label>
        <input asp-for="ShippingAddress" />
    </div>
    <div class="form-group">
        <label asp-for="City"></label>
        <input asp-for="City" />
    </div>
    <div class="form-group">
        <label asp-for="PostalCode"></label>
        <input asp-for="PostalCode" />
    </div>
    <div class="form-group">
        <label asp-for="Country"></label>
        <input asp-for="Country" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">Save Customer</button>
        <a class="btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>
