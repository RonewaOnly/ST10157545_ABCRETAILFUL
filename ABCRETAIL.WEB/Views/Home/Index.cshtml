@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h1>ABC Retail Order Management</h1>
    <p>
        A cloud-native web application demonstrating the use of Azure Storage
        services to modernize ABC Retail's order processing system.
    </p>
</section>

<div class="card-grid">
    <div class="info-card">
        <h2>Customer Profiles</h2>
        <p>Customer data is stored and retrieved using <strong>Azure Table Storage</strong>, a fast, NoSQL key-value store well suited for high-volume structured data.</p>
        <a class="btn" asp-controller="Customers" asp-action="Index">Manage Customers</a>
    </div>
    <div class="info-card">
        <h2>Products</h2>
        <p>Product information lives in <strong>Azure Table Storage</strong>, while product images and multimedia are hosted in <strong>Azure Blob Storage</strong> for efficient, scalable delivery.</p>
        <a class="btn" asp-controller="Products" asp-action="Index">Manage Products</a>
    </div>
    <div class="info-card">
        <h2>Order Processing</h2>
        <p>Placing an order deducts stock in Table Storage and enqueues a transaction message onto <strong>Azure Queue Storage</strong>, decoupling order intake from inventory processing.</p>
        <a class="btn" asp-controller="Orders" asp-action="Index">View Orders</a>
    </div>
    <div class="info-card">
        <h2>Documents</h2>
        <p>Invoices, reports and other documents are uploaded to and retrieved from an <strong>Azure Files</strong> share, addressable by their original file name.</p>
        <a class="btn" asp-controller="Documents" asp-action="Index">Manage Documents</a>
    </div>
</div>
