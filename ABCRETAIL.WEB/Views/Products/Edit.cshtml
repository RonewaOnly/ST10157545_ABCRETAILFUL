@model Product
@{
    ViewData["Title"] = "Edit Product";
}

<h1>Edit Product</h1>

@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <img src="@Model.ImageUrl" alt="@Model.ProductName" class="product-image preview" />
}

<form asp-action="Edit" asp-route-partitionKey="@Model.PartitionKey" asp-route-rowKey="@Model.RowKey"
      method="post" enctype="multipart/form-data" class="form">
    <div class="form-group">
        <label asp-for="ProductName"></label>
        <input asp-for="ProductName" required />
    </div>
    <div class="form-group">
        <label asp-for="Category"></label>
        <input asp-for="Category" required />
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" min="0" required />
    </div>
    <div class="form-group">
        <label asp-for="StockQuantity"></label>
        <input asp-for="StockQuantity" type="number" min="0" required />
    </div>
    <div class="form-group">
        <label for="imageFile">Replace Image (optional)</label>
        <input type="file" id="imageFile" name="imageFile" accept="image/*,video/*" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">Save Changes</button>
        <a class="btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>
