@model Product
@{
    ViewData["Title"] = "New Product";
}

<h1>New Product</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="form">
    <div class="form-group">
        <label asp-for="ProductName"></label>
        <input asp-for="ProductName" required />
    </div>
    <div class="form-group">
        <label asp-for="Category"></label>
        <input asp-for="Category" placeholder="e.g. Electronics" required />
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" min="0" required />
    </div>
    <div class="form-group">
        <label asp-for="StockQuantity"></label>
        <input asp-for="StockQuantity" type="number" min="0" required />
    </div>
    <div class="form-group">
        <label for="imageFile">Product Image (uploaded to Azure Blob Storage)</label>
        <input type="file" id="imageFile" name="imageFile" accept="image/*,video/*" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">Save Product</button>
        <a class="btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>
